<style>
	.parallax,
	.overlay,
	.light {
		position: fixed;
		left: 0;
		pointer-events: none;
	}
	.overlay,
	.blobs-layer {
		inset: 0;
	}
	.parallax {
		top: -36px;
		width: 100%;
		height: calc(100% + 72px);
		--pattern-foreground: color-mix(in oklab, white 22%, transparent);
		background-image: radial-gradient(var(--pattern-foreground) 1.5px, transparent 1.5px);
		background-size: 18px 18px;
		z-index: -102;
		will-change: transform;
		transform: translate3d(0, 0, 0);
	}
	.overlay {
		background: linear-gradient(
			to right,
			rgba(0, 0, 0, 0.82),
			rgba(0, 0, 0, 0.45) 50%,
			rgba(0, 0, 0, 0.82)
		);
		z-index: -101;
	}
	.light {
		top: 0;
		width: 520px;
		height: 520px;
		margin: -260px 0 0 -260px;
		border-radius: 50%;
		background: radial-gradient(
			circle at 50% 50%,
			rgba(255, 255, 255, 0.10) 0%,
			rgba(46, 153, 240, 0.14) 25%,
			rgba(138, 93, 255, 0.08) 50%,
			transparent 70%
		);
		box-shadow: 0 0 90px 30px rgba(0, 0, 0, 0.8), 0 0 0 9999px rgba(0, 0, 0, 0.8);
		z-index: -100;
		will-change: transform;
		transform: translate3d(50vw, 45vh, 0);
	}
	@media (max-width: 1200px) {
		.parallax {
			top: 0;
			height: 100%;
			transform: none !important;
		}
		.overlay {
			background: linear-gradient(
				to right,
				rgba(0, 0, 0, 0.82),
				rgba(0, 0, 0, 0.25) 50%,
				rgba(0, 0, 0, 0.82)
			);
		}
		.light {
			display: none;
		}
	}
	.blobs-layer {
		position: absolute;
		overflow: hidden;
		pointer-events: none;
		z-index: -99;
		contain: strict;
	}
	.blob {
		position: absolute;
		aspect-ratio: 1;
		will-change: transform;
		filter: blur(16px);
		background: radial-gradient(
			closest-side circle at 50% 50%,
			rgb(var(--c) / var(--a, 0.25)) 0%,
			rgb(var(--c) / calc(var(--a, 0.25) * 0.64)) 25%,
			rgb(var(--c) / calc(var(--a, 0.25) * 0.28)) 50%,
			rgb(var(--c) / calc(var(--a, 0.25) * 0.072)) 75%,
			rgb(var(--c) / 0) 92%,
			transparent 100%
		);
		animation: blobFloat var(--dur, 25s) ease-in-out infinite alternate;
	}
	.blob:nth-child(even) {
		animation-name: blobFloatAlt;
	}
	.blob-1, .blob-5, .blob-8, .blob-12 { --c: 46 153 240; }
	.blob-2, .blob-6, .blob-9, .blob-11 { --c: 155 39 176; }
	.blob-3, .blob-7, .blob-10 { --c: 26 170 226; }
	.blob-4 { --c: 138 93 255; }

	.blob-1 { top: 2%; right: 3vw; width: clamp(260px, 30vw, 480px); --a: 0.28; --dur: 22s; }
	.blob-2 { top: 11%; left: 2vw; width: clamp(280px, 32vw, 500px); --a: 0.26; --dur: 26s; }
	.blob-3 { top: 21%; right: 7vw; width: clamp(240px, 26vw, 440px); }
	.blob-4 { top: 30%; left: 4vw; width: clamp(260px, 28vw, 460px); --a: 0.24; --dur: 24s; }
	.blob-5 { top: 39%; right: 5vw; width: clamp(240px, 26vw, 420px); --a: 0.23; --dur: 28s; }
	.blob-6 { top: 49%; left: 3vw; width: clamp(280px, 30vw, 480px); --dur: 27s; }
	.blob-7 { top: 57%; right: 4vw; width: clamp(260px, 28vw, 460px); --a: 0.24; --dur: 23s; }
	.blob-8 { top: 67%; left: 6vw; width: clamp(290px, 32vw, 520px); }
	.blob-9 { top: 75%; right: 4vw; width: clamp(300px, 34vw, 540px); --a: 0.24; --dur: 29s; }
	.blob-10 { top: 83%; left: 3vw; width: clamp(280px, 30vw, 500px); --a: 0.23; --dur: 24s; }
	.blob-11 { top: 90%; right: 12vw; width: clamp(280px, 30vw, 480px); --dur: 26s; }
	.blob-12 { top: 94%; left: 10vw; width: clamp(260px, 28vw, 460px); --dur: 28s; }

	@keyframes blobFloat {
		0% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		50% {
			transform: translate3d(24px, -32px, 0) scale(1.06);
		}
		100% {
			transform: translate3d(-18px, -50px, 0) scale(0.97);
		}
	}

	@keyframes blobFloatAlt {
		0% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		50% {
			transform: translate3d(-24px, 30px, 0) scale(1.05);
		}
		100% {
			transform: translate3d(20px, 16px, 0) scale(0.98);
		}
	}
	mark {
		position: relative;
		background-color: transparent;
	}
	mark::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: 0;
		background-color: yellow;
		z-index: -1;
	}
	mark.animate-mark::after {
		animation: animateMarkBefore 1s 0.5s forwards;
	}
	@keyframes animateMarkBefore {
		from {
			width: 0;
		}
		to {
			width: 100%;
		}
	}
	#projects {
		margin-top: 10vh;
		scroll-margin-top: 6rem;
		width: 100%;
		position: relative;
		overflow: hidden;
		padding-bottom: 6rem;
	}

	.projects-marquee-header {
		margin-bottom: clamp(2rem, 4svh, 3.5rem);
		z-index: 5;
	}

	.marquee-container {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: clamp(0.5rem, 1.2vw, 0.9rem);
	}

	.marquee-container::before,
	.marquee-container::after {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		width: clamp(50px, 12vw, 180px);
		z-index: 6;
		pointer-events: none;
	}

	.marquee-container::before {
		left: 0;
		background: linear-gradient(to right, #000000 0%, rgba(0, 0, 0, 0.8) 40%, transparent 100%);
	}

	.marquee-container::after {
		right: 0;
		background: linear-gradient(to left, #000000 0%, rgba(0, 0, 0, 0.8) 40%, transparent 100%);
	}

	.marquee-row {
		width: 100%;
		overflow: hidden;
		padding-block: 54px;
		margin-block: -40px;
	}

	.marquee-track,
	.marquee-group {
		display: flex;
		flex-shrink: 0;
		width: max-content;
	}

	.marquee-track {
		will-change: transform;
	}

	.marquee-group {
		gap: clamp(1rem, 2vw, 1.5rem);
		padding-right: clamp(1rem, 2vw, 1.5rem);
	}

	@media (hover: hover) and (min-width: 821px) {
		.marquee-row:hover .marquee-track,
		.marquee-track:hover {
			animation-play-state: paused !important;
		}
	}

	.marquee-left,
	.marquee-right {
		animation: marqueeLeft 40s linear infinite;
	}

	.marquee-right {
		animation-direction: reverse;
	}

	@keyframes marqueeLeft {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	@media screen and (max-width: 700px) {
		#projects {
			margin-top: 5svh;
			padding-bottom: 3rem;
		}

		.marquee-row {
			padding-block: 36px;
			margin-block: -24px;
		}

		.marquee-left,
		.marquee-right {
			animation-duration: 25s;
		}
	}
	#contact {
		scroll-margin-top: 6rem;
	}
	.contact {
		display: flex;
		justify-content: center;
		gap: clamp(1.2rem, 3vw, 2rem);
		padding: 1rem;
	}
	.contact-btn.contact-cv-btn {
		display: none !important;
	}
	@media screen and (max-width: 820px) {
		.contact {
			flex-direction: column;
			width: 100%;
			align-items: center;
		}
		.contact .contact-btn {
			width: min(280px, 85vw);
			padding: 1.2rem 1.5rem;
		}
		.contact-btn.contact-cv-btn {
			display: flex !important;
		}
	}
</style>
