---
const links = [
	{ href: "#home", text: "Home" },
	{ href: "#projects", text: "Projects" },
	{ href: "#contact", text: "Contact" },
];
---

<script>
	let activeSection = "home";
	const nav = document.querySelector("nav");
	const highlight = document.querySelector(".highlight") as HTMLElement | null;
	const links = document.querySelectorAll("nav a") as NodeListOf<HTMLAnchorElement>;

	const linkMetrics = new Map<string, { offsetLeft: number; offsetWidth: number }>();
	let projectsTop = 0;
	let projectsBottom = 0;

	const measureAll = () => {
		links.forEach((link) => {
			const href = link.getAttribute("href") || "";
			const sectionId = href.startsWith("#") ? href.substring(1) : href;
			linkMetrics.set(sectionId, {
				offsetLeft: link.offsetLeft,
				offsetWidth: link.offsetWidth,
			});
		});

		const projectsEl = document.querySelector("#projects") as HTMLElement | null;
		if (projectsEl) {
			const rect = projectsEl.getBoundingClientRect();
			const top = rect.top + window.scrollY;
			projectsTop = top;
			projectsBottom = top + projectsEl.offsetHeight;
		}
	};

	const applyHighlight = (sectionId: string) => {
		if (!highlight) return;
		const metrics = linkMetrics.get(sectionId);
		if (metrics) {
			highlight.style.transform = `translateX(${metrics.offsetLeft}px)`;
			highlight.style.width = `${metrics.offsetWidth}px`;
		}
	};

	const scrollToSection = (selector: string) => {
		if (selector === "#home") {
			window.scrollTo({
				top: 0,
				behavior: "smooth",
			});
			return;
		}

		const target = document.querySelector(selector);
		if (!(target instanceof HTMLElement)) return;

		const navOffset = nav instanceof HTMLElement ? nav.getBoundingClientRect().bottom + 16 : 80;
		const targetTop = target.getBoundingClientRect().top + window.scrollY;

		window.scrollTo({
			top: Math.max(0, targetTop - navOffset),
			behavior: "smooth",
		});
	};

	const getSectionForScroll = () => {
		const scrollPosition = window.scrollY + window.innerHeight * 0.45;
		if (projectsBottom > 0 && scrollPosition >= projectsBottom) {
			return "contact";
		}
		if (projectsTop > 0 && scrollPosition >= projectsTop) {
			return "projects";
		}
		return "home";
	};

	let isMeasured = false;
	const initNav = () => {
		measureAll();
		activeSection = getSectionForScroll();
		applyHighlight(activeSection);
		isMeasured = true;
		if (highlight && !highlight.classList.contains("ready")) {
			void highlight.offsetWidth;
			highlight.classList.add("ready");
		}
	};

	const ensureMeasured = () => {
		if (!isMeasured) {
			initNav();
		}
	};

	initNav();
	document.fonts?.ready.then(() => {
		measureAll();
		applyHighlight(activeSection);
	});
	window.addEventListener("load", initNav, { once: true });

	window.addEventListener("resize", () => {
		measureAll();
		applyHighlight(activeSection);
	}, { passive: true });

	// Hover interactions
	links.forEach((link) => {
		link.addEventListener("mouseenter", () => {
			ensureMeasured();
			const href = link.getAttribute("href") || "";
			const sectionId = href.startsWith("#") ? href.substring(1) : href;
			applyHighlight(sectionId);
		});
		link.addEventListener("mouseleave", () => {
			ensureMeasured();
			applyHighlight(activeSection);
		});
		link.addEventListener("click", (event) => {
			const href = link.getAttribute("href");
			if (!href || !href.startsWith("#")) return;

			event.preventDefault();
			ensureMeasured();
			const sectionId = href.substring(1);
			if (activeSection !== sectionId) {
				activeSection = sectionId;
				applyHighlight(activeSection);
			}
			scrollToSection(href);
		});
	});

	// Fast scroll listener: zero forced layouts, zero DOM mutation unless section changes
	let scrollTicking = false;
	window.addEventListener("scroll", () => {
		if (scrollTicking || !isMeasured) return;
		scrollTicking = true;
		requestAnimationFrame(() => {
			const newSection = getSectionForScroll();

			if (newSection !== activeSection) {
				activeSection = newSection;
				applyHighlight(activeSection);
			}
			scrollTicking = false;
		});
	}, { passive: true });
</script>

<nav>
	<div class="nav-inner">
		<div class="highlight"></div>
		{links.map((link) => <a href={link.href}>{link.text}</a>)}
	</div>
</nav>

<style>
	nav {
		top: 3svh;
		position: fixed;
		border-radius: 90pt;
		padding: 0.5rem;
		background-color: rgba(20, 20, 20, 0.8);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		z-index: 100;
		box-shadow: inset 0 0 15px 0 rgba(53, 53, 53, 0.5);
		@media (max-width: 1200px) {
			width: 80vw;
		}
		@media (min-width: 1000px) and (max-width: 1920px) {
			width: clamp(420px, 38vw, 700px);
			top: 4vh;
			padding: 0.25rem 0.5rem;
		}
	}
	.nav-inner {
		position: relative;
		display: flex;
		justify-content: space-around;
		align-items: center;
	}

	nav a {
		color: rgb(216, 216, 216);
		padding: 0.7rem 1.2rem;
		position: relative;
		z-index: 1;
		@media (min-width: 1000px) and (max-width: 1920px) {
			font-size: 28px;
		}
	}

	.highlight {
		position: absolute;
		left: 0;
		top: 0;
		height: 100%;
		opacity: 0;
		will-change: transform, width;
		border-radius: 999px;

		background: rgba(255, 255, 255, 0.08);

		backdrop-filter: blur(18px) saturate(180%);
		-webkit-backdrop-filter: blur(18px) saturate(180%);

		border: 1px solid rgba(255, 255, 255, 0.18);

		box-shadow:
			0 10px 30px rgba(0, 0, 0, 0.25),
			inset 0 1px 1px rgba(255, 255, 255, 0.35),
			inset 0 -6px 12px rgba(0, 0, 0, 0.15);

		overflow: hidden;
	}

	.highlight.ready {
		opacity: 1;
		transition: transform 0.3s ease, width 0.3s ease, opacity 0.15s ease;
	}

	.highlight::before {
		position: absolute;
		content: "";
		bottom: -60%;
		left: 20%;
		height: 70%;
		border-radius: 100%;
		width: 60%;
		background-color: rgba(255, 255, 255, 0.4);
		filter: blur(10px);
	}
</style>
