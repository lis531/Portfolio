---
---

<section class="hero flex-center" aria-labelledby="hero-title">
	<div class="hero-content col-center">
		<p class="kicker animate">PORTFOLIO / FRONTEND / SOFTWARE</p>
		<h1 id="hero-title" class="animate hero-title no-glow">
			<span class="hero-title-first">BORYS</span>
			<span class="hero-title-last">GAJEWSKI</span>
		</h1>
		<p class="hero-lead animate">
			I am a <mark>developer</mark> from Poland focused on building websites,
			small games, and practical software.
		</p>
		<div class="hero-actions">
			<a class="animate glass-btn cv-button" href="/Borys_Gajewski_CV.pdf" target="_blank" rel="noopener" download>
				<svg class="cv-icon" stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" height="24px" width="24px" xmlns="http://www.w3.org/2000/svg">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="7 10 12 15 17 10"></polyline>
					<line x1="12" y1="15" x2="12" y2="3"></line>
				</svg>
				Download CV
			</a>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100lvh;
		width: min(96vw, 1300px);
		padding: 6rem 0 3rem;
	}

	.hero-title {
		padding: 0 0 1rem;
		display: flex;
		flex-direction: column;
		.hero-title-first {
			color: white;
		}
		.hero-title-last {
			font-weight: bold;
			font-family: "Alata";
		}
	}

	.hero-lead {
		margin: 1.3rem 0 0;
		max-width: 900px;
		width: 88%;
		font-size: clamp(1.2rem, 2.4vw, 2.2rem);
		line-height: 1.3;
	}

	.hero-actions {
		display: flex;
		margin-top: 1.3rem;
		justify-content: center;
	}

	.cv-button .cv-icon {
		transition: opacity 0.3s ease, transform 0.25s ease;
	}

	.cv-button:hover .cv-icon {
		transform: translateY(2px);
	}

	@media (max-width: 700px) {
		.hero {
			min-height: 100svh;
			padding: 5rem 1rem 3rem;
		}

		.hero-content {
			width: 100%;
			max-width: 600px;
		}

		.hero-lead {
			width: 100%;
			max-width: 520px;
		}
	}
</style>
