---
interface Props {
	skills: Array<{
		logo: string;
		alt: string;
		level: number;
	}>;
}

const { skills } = Astro.props;
---

<div class="allSkills flex-center">
	{
		skills.map((skill) => (
			<div class="skill flex-center animate" style={`--skill-level: ${(skill.level / 100) * 360}deg;`} title={`${skill.alt}: ${skill.level}%`}>
				<img src={skill.logo} alt={skill.alt} loading="lazy" />
			</div>
		))
	}
</div>

<style>
	.allSkills {
		width: 55vw;
		flex-wrap: wrap;
		@media (max-width: 1200px) {
			width: 80vw;
		}
	}
	.skill {
		position: relative;
		width: 90px;
		height: 90px;
		border-radius: 24px;
		margin: 16px;
		cursor: pointer;
		transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
		@media (max-width: 1000px) {
			width: 80px;
			height: 80px;
			margin: 10px;
		}
		@media (max-width: 600px) {
			width: 68px;
			height: 68px;
			margin: 8px;
			border-radius: 20px;
		}
	}
	.skill::before {
		content: "";
		position: absolute;
		inset: -4px;
		border-radius: 26px;
		z-index: 0;
		pointer-events: none;
		transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
		transform: scale(0.9);
		opacity: 0;
		background-image: conic-gradient(
			#2e99f0 0deg,
			#9b27b0 var(--skill-level, 180deg),
			rgba(255, 255, 255, 0.08) var(--skill-level, 180deg) 360deg
		);
	}
	.skill:hover::before,
	.skill:focus-visible::before {
		transform: scale(1.08);
		opacity: 1;
	}
	.skill:hover,
	.skill:focus-visible {
		transform: translateY(-3px);
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 20px rgba(46, 153, 240, 0.25);
	}

	@media (hover: none), (max-width: 768px) {
		.skill::before,
		.skill:hover::before,
		.skill:focus-visible::before {
			opacity: 1;
			transform: scale(1);
			inset: -2.5px;
			border-radius: 22.5px;
		}

		.skill:hover,
		.skill:focus-visible {
			transform: none;
			box-shadow: none;
		}
	}
	.skill > img {
		position: relative;
		z-index: 1;
		background-color: #0c0f17;
		width: 100%;
		height: 100%;
		padding: 14px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: inherit;
		object-fit: contain;
		transition: border-color 0.3s ease;
	}
	.skill:hover > img {
		border-color: rgba(46, 153, 240, 0.4);
	}
</style>
