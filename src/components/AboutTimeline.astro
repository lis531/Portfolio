---
interface TimelineEvent {
	title: string;
	organization: string;
	period: string;
	location?: string;
	description: string[];
}

const events: TimelineEvent[] = [
	{
		title: "Programming Intern",
		organization: "DTP Sp. z o.o.",
		period: "2026-03 - 2026-03",
		location: "Cieszyn, Poland",
		description:
			[
				"Worked with AI/LLM technologies: vision models, LangChain, MCP, embeddings, prompt engineering, and Docker.",
				"Built AI prototypes and evaluated models.",
				"Developed backend-integrated software solutions.",
			],
	},
	{
		title: "Programming Intern",
		organization: "ELEKTROMETAL SPÓŁKA AKCYJNA",
		period: "2025-04 - 2025-04",
		location: "Cieszyn",
		description:
			[
				"Developed a Python and C# application for processing mining gas detector data.",
				"Gained experience in industrial software development and practical programming.",
			],
	},
	{
		title: "Foreign Programming Internship",
		organization: "VITALIS Betreuungsgesellschaft",
		period: "2025-03 - 2025-03",
		location: "Schkeuditz",
		description:
			[
				"Built websites and worked with smart devices.",
				"Gained hands-on experience in networking and international teamwork.",
				"Learned German workplace practices and collaboration standards.",
			],
	},
];
---

<script>
		const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

	const updateTimeline = (timeline: HTMLElement) => {
		const shell = timeline.querySelector(".timeline-shell") as HTMLElement | null;
		const rail = timeline.querySelector(".timeline-rail") as HTMLElement | null;
		const progress = timeline.querySelector(".timeline-progress") as HTMLElement | null;
		const dots = [...timeline.querySelectorAll(".dot")] as HTMLElement[];

		if (!shell || !rail || !progress || dots.length === 0) {
			return;
		}

		const shellRect = shell.getBoundingClientRect();
		const dotCenters = dots.map((dot) => {
			const dotRect = dot.getBoundingClientRect();
			return dotRect.top - shellRect.top + dotRect.height / 2;
		});
		const start = dotCenters[0];
		const end = dotCenters[dotCenters.length - 1];
		const height = Math.max(end - start, 0);
		const scrollLine = window.innerHeight * 0.55 - shellRect.top - start;
		const lineLead = dots[0].offsetHeight / 2;

		rail.style.top = `${start}px`;
		rail.style.height = `${height}px`;
		progress.style.height = `${clamp(scrollLine + lineLead, 0, height)}px`;

		dots.forEach((dot, index) => {
			const filled = scrollLine >= dotCenters[index] - start;
			dot.classList.toggle("filled", filled);
		});
	};

	const initTimelines = () => {
		const timelines = [...document.querySelectorAll(".about-timeline")] as HTMLElement[];
		const updateAll = () => timelines.forEach(updateTimeline);

		window.addEventListener("scroll", updateAll, { passive: true });
		window.addEventListener("resize", updateAll);
		updateAll();
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initTimelines);
	} else {
		initTimelines();
	}
</script>

<section class="about-timeline space" aria-labelledby="timeline-title">
	<div class="about-heading">
		<p class="about-kicker marker-reveal">ABOUT / EXPERIENCE / WAY OF WORKING</p>
		<h1 id="timeline-title" class="marker-reveal">ABOUT ME</h1>
	</div>
	<div class="about-grid">
		<p class="about-quote marker-reveal block">
			"Make it useful first. Then make it feel alive."
		</p>
		<div class="timeline-shell">
			<div class="timeline-rail" aria-hidden="true">
				<div class="timeline-progress"></div>
			</div>

			<ol class="timeline-list">
				{events.map((event, index) => (
					<li class="timeline-item">
						<div class="dot" aria-hidden="true"></div>
						<div class="content">
							<div class="heading">
								<span class="period">{event.period}</span>
								<span class="event-index">0{index + 1}</span>
							</div>
							<p class="meta">
								<h3>{event.title}</h3>
								<p class="meta-text">{event.organization} / {event.location}</p>
							</p>
							<ul class="description">
								{event.description.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.about-grid {
		width: min(1180px, 100%);
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(1.2rem, 4vw, 3rem);
		align-items: start;
	}

	.about-timeline {
		width: min(96vw, 1100px);
		padding: 0 0 8rem;
		display: flex;
    	flex-direction: column;
    	align-items: center;
	}

	.about-heading {
		width: min(1180px, 100%);
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		margin-inline: auto;
	}

	.about-kicker {
		margin: 0 0 3vh;
		color: #1aaae2;
		font-family: "Alata";
		font-size: clamp(0.74rem, 1.2vw, 0.9rem);
		line-height: 1;
		text-align: left;
		text-transform: uppercase;
	}

	.timeline-shell {
		position: relative;
		width: 100%;
		margin-top: 0;
	}

	.timeline-rail {
		position: absolute;
		left: 13px;
		width: 3px;
		background: rgba(226, 235, 238, 0.1);
		border-radius: 999px;
	}

	.timeline-progress {
		width: 100%;
		background: #1aaae2;
		border-radius: inherit;
		box-shadow: 0 0 18px rgba(47, 175, 214, 0.42);
	}

	.timeline-list {
		display: grid;
    	gap: clamp(1.4rem, 4vw, 2.4rem);
    	margin: 0;
    	padding: 0 0 0 4.25rem;
    	list-style: none;
	}

	.about-quote {
		width: min(440px, 100%);
		margin: 0;
		color: rgba(226, 237, 238, 0.58);
		font-family: "FugazOne";
		font-size: clamp(1.7rem, 3.2vw, 3rem);
		font-style: italic;
		line-height: 0.95;
		text-align: left;
	}

	.timeline-item {
		position: relative;
	}

	.dot {
		position: absolute;
		top: 50%;
		left: -4.25rem;
		width: 28px;
		aspect-ratio: 1;
		box-sizing: border-box;
		border: 2px solid rgba(226, 236, 238, 0.78);
		border-radius: 8px;
		background: #0a0d08;
		box-shadow: 0 0 5px #0a0d08, 0 0 8px rgba(229, 232, 238, 0.2);
		transform: translateY(-50%);
		overflow: hidden;
		z-index: 1;
	}

	.dot::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: #1aaae2;
		transform: scale(0);
		transition: transform 0.25s ease-out;
	}

	.dot.filled {
		box-shadow: 0 0 5px #0a0d08, 0 0 18px rgba(229, 232, 238, 0.42);
	}

	.dot.filled::after {
		transform: scale(1.1);
	}

	.content {
		padding: clamp(1.15rem, 2.2vw, 1.55rem);
		border-radius: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
		background:
			linear-gradient(90deg, rgba(226, 236, 238, 0.05) 1px, transparent 1px),
			linear-gradient(0deg, rgba(226, 236, 238, 0.05) 1px, transparent 1px),
			rgba(10, 13, 15, 0.82);
		background-size: 38px 38px;
	}

	.heading {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}

	.period {
		padding: 0.5rem 0.75rem;
		border: 1px solid rgba(226, 235, 238, 0.13);
		border-radius: 8px;
		color: #1aaae2;
		background: rgba(47, 175, 214, 0.08);
		font-size: 0.9rem;
		line-height: 1;
	}

	.event-index {
		color: rgba(226, 235, 238, 0.22);
		font-family: "FugazOne";
		font-size: clamp(1.8rem, 4vw, 3.4rem);
		line-height: 0.8;
	}

	.meta-text {
		margin-top: 0.45rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 1rem;
		margin: 0;
		text-align: left;
	}

	h3 {
		margin: 0;
		font-family: "Alata";
		font-size: clamp(1.2rem, 2.3vw, 1.9rem);
	}

	.meta {
		margin: 0.35rem 0 0;
		text-align: left;
		font-size: clamp(0.95rem, 1.7vw, 1.15rem);
		opacity: 0.85;
		line-height: 1.4;
	}

	.description {
		padding-left: 1.1rem;
		margin-top: 0.9rem;
		font-family: "Albert Sans";
		font-size: 1rem;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.86);
	}

	.description > li {
		margin: 0.35rem 0;
	}

	@media (max-width: 700px) {
		.about-timeline {
			padding-bottom: 5rem;
		}

		.timeline-item {
			--content-pad-y: 0.85rem;
		}

		.content {
			padding: 0.85rem 0.9rem;
		}
	}
</style>
